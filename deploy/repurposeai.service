[Unit]
Description=RepurposeAI API+worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repurposeai
Environment=DATABASE_URL=sqlite:///./data/rpa.db
Environment=PORT=8001
ExecStart=%h/repurposeai/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
