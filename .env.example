APP_ENV=local
DATABASE_URL=sqlite:///./data/repurposeai.db
STORAGE_PATH=./data
STORAGE_BACKEND=local
# S3_STORAGE_BUCKET=  S3_STORAGE_PREFIX=repurposeai/  AWS_REGION=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Remote STT via GitHub Actions (option): homie/any private box pushes a gist,
# a GH runner transcribes, homie polls back the result. STT_PROVIDER=github
# forces remote; auto = local (faster-whisper) with remote fallback.
# Requires a classic PAT with gist+repo scopes; same token must be set as the
# GH repo secret REMOTE_STT_PAT for the transcribe.yml workflow.
# STT_PROVIDER=auto
# GITHUB_TOKEN=ghp_...
# GITHUB_OWNER=ammar0xff
# GITHUB_REPO=repurposeai
LLM_PROVIDER=heuristic
# LLM_BASE_URL=http://127.0.0.1:3001/v1  LLM_MODEL=gpt-oss-20b  LLM_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
MAX_UPLOAD_MB=2048
MAX_CONCURRENT_JOBS=2
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
AUTH_TOKEN=
PORT=8000
